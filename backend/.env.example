# 复制本文件为 .env 并填入真实值，.env 不会被提交到 git

# Django
SECRET_KEY=请用 python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())" 生成
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (mysql://user:password@host:port/dbname)
DATABASE_URL=mysql://root:your_password@localhost:3306/policy_db

# CORS（开发环境允许 Vite dev server 跨域）
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
