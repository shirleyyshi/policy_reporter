# Policy_Reporter 环境变量示例（给 docker-compose 用）
# 复制本文件为 .env 并填入真实值，.env 不会被提交到 git

# Django SECRET_KEY（必填）
# 生成命令：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key

# MySQL root 密码（必填，docker-compose 会用这个初始化 DB）
DB_ROOT_PASSWORD=change-me-to-a-strong-password

# DeepSeek API（必填）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Django DEBUG（生产环境必须 False）
DEBUG=False

# ALLOWED_HOSTS（生产环境填你的域名，如 policy.yourdomain.com）
ALLOWED_HOSTS=localhost,backend,policy.yourdomain.com

# CORS（生产环境填你的前端域名）
CORS_ALLOWED_ORIGINS=http://localhost,https://policy.yourdomain.com

# Django admin IP 白名单（D6 生产加固，逗号分隔）
# 留空=开发环境放行所有；生产环境填你的家庭/办公 IP 防止公网暴力破解
# 查你的公网 IP：curl -s ifconfig.me
ADMIN_ALLOWED_IPS=
